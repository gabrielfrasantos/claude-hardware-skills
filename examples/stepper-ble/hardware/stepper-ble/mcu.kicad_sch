	(text "STM32WB55CGU6 (ST DS11929 Rev 11)"
		(exclude_from_sim no)
		(at 16.51 19.05 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "08a22939-ebcf-5858-89ec-2d67915cd14e")
	)
	(text "Supplies per DS11929 Fig. 16: VDD n x 100 nF + 4.7 uF (C401-C404); VDDA 10 nF + 1 uF (C405, C406);\nVDDRF 100 nF + 100 pF (C407, C408); VDDSMPS 4.7 uF (C409); VFBSMPS 4.7 uF (C410); VBAT and VDDUSB on +3V3.\nSMPS at 8 MHz: L1 2.2 uH (Table 6) plus the 10 nH series inductor of note 2 (LQG15WZ10NJ02D, as named there).\nAT0/AT1: reserved, must be kept unconnected (pin table note 7). BOOT0 pulled down: boot from flash.\nNRST 100 nF to GND (ASSUMPTION: ST's usual value; the pin has its internal pull-up)."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "64d12ccc-b4c9-5953-ae09-f0c8fb201c86")
	)
	(text "HSE: NX2016SA 32 MHz, the crystal DS11929 Table 5 names; load caps are on-chip (HSETUNE).\nASSUMPTION: CS06465 (CL 10 pF) instead of ST's CS06654; trim HSETUNE at bring-up.\nLSE: FC-135, CL 12.5 pF: C = 2 (CL - Cstray) = 2 (12.5 - 3.5) = 18 pF (derived; Cstray ASSUMPTION)."
		(exclude_from_sim no)
		(at 256.54 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c47a78c-6cee-5a08-9bb4-02f815759912")
	)
	(text "Clocks"
