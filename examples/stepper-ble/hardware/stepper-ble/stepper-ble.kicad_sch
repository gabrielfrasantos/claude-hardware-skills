	(text "U401 STM32WB55CGU6, SMPS mode\nHSE 32 MHz, LSE 32.768 kHz\nReset, BOOT0, ADC inputs\nI/O by pin map (pin-data/pinmap.txt)"
		(exclude_from_sim no)
		(at 322.58 74.93 0)
		(effects
