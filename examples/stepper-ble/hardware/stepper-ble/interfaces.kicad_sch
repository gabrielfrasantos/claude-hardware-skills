		(uuid "f3aa027c-78e2-55f8-bb61-45ae91ab12d7")
	)
	(text "TC2030 (no part on the board): SWD, NRST, SWO.\nLEDs: (3.3 V - 2.0 V) / 1 kohm = 1.3 mA (derived).\nButton: 10 kohm pull-up, 100 nF = 1 ms RC debounce."
		(exclude_from_sim no)
		(at 215.9 114.3 0)
