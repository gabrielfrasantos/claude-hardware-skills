	(text "Sink: 5.1 kohm Rd on CC1 and CC2 (USB Type-C spec 4.11).\nD+/D- joined across the two rows (either plug orientation).\nUSBLC6-2SC6 at the connector; D+/D- 90 ohm differential (DIFF_90).\nShield to GND through R603 (0 ohm; swap for an RC if EMC needs).\nVBUS -> D204 (sheet 2): USB powers the logic without 24 V."
		(exclude_from_sim no)
		(at 101.6 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c7775207-a313-5014-8b80-889ce00917b1")
	)
